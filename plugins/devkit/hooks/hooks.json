{
  "description": "guard: checks shell commands and file edits before they run (see skills/guard)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/guard/scripts/guard.py\" hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/guard/scripts/guard.py\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
